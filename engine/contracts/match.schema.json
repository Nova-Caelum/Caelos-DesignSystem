{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Match output",
  "type": "object",
  "required": ["matches"],
  "additionalProperties": false,
  "properties": {
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["need", "match"],
            "additionalProperties": false,
            "properties": {
              "need": { "type": "string", "minLength": 1 },
              "match": {
                "type": "string",
                "pattern": "^(?!none$)(?!none, new kind$)[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$"
              }
            }
          },
          {
            "type": "object",
            "required": ["need", "match"],
            "additionalProperties": false,
            "properties": {
              "need": { "type": "string", "minLength": 1 },
              "match": { "const": "none" }
            }
          },
          {
            "type": "object",
            "required": ["need", "match", "kind"],
            "additionalProperties": false,
            "properties": {
              "need": { "type": "string", "minLength": 1 },
              "match": { "const": "none, new kind" },
              "kind": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
            }
          }
        ]
      }
    }
  }
}
