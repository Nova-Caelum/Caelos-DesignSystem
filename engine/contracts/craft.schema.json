{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Craft wireframe output",
  "type": "object",
  "required": ["container", "arrangement", "needs"],
  "additionalProperties": false,
  "properties": {
    "container": {
      "type": "string",
      "enum": ["plain", "catalog-entry"]
    },
    "arrangement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["region", "needs"],
        "additionalProperties": false,
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "needs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "purpose", "states", "triggers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "what": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
