{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assemble output",
  "type": "object",
  "required": ["path", "source", "importedEntries", "handlers"],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.tsx$"
    },
    "source": { "type": "string", "minLength": 1 },
    "importedEntries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "handlers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
