{
  "chain": "creative",
  "steps": [
    {
      "step": "craft",
      "kind": "model",
      "instructions": "engine/contracts/craft.instructions.md",
      "schema": "engine/contracts/craft.schema.json",
      "inputs": ["brief.md", "behaviours.json"],
      "outputs": ["wireframe.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "match",
      "kind": "model",
      "instructions": "engine/contracts/match.instructions.md",
      "schema": "engine/contracts/match.schema.json",
      "inputs": ["wireframe.json"],
      "outputs": ["match.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "integrate",
      "kind": "model",
      "instructions": "engine/contracts/integrate.instructions.md",
      "schema": "engine/contracts/integrate.schema.json",
      "inputs": ["job.json", "wireframe.json", "match.json", "reference"],
      "outputs": ["integrate.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "generate",
      "kind": "script",
      "script": "scripts/generate-components.mjs",
      "inputs": ["integrate.json"],
      "outputs": ["generated-components.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "assemble",
      "kind": "model",
      "instructions": "engine/contracts/assemble.instructions.md",
      "schema": "engine/contracts/assemble.schema.json",
      "inputs": ["wireframe.json", "match.json", "integrate.json", "generated-components.json", "behaviours.json"],
      "outputs": ["assemble.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "count-handlers",
      "kind": "script",
      "script": "scripts/behaviour-check/count-handlers.mjs",
      "inputs": ["assemble.json", "behaviours.json"],
      "outputs": ["handler-count.json"],
      "check": "npm run check:catalog"
    },
    {
      "step": "finish",
      "kind": "script",
      "script": "engine/lib/finish.mjs",
      "inputs": ["integrate.json", "assemble.json", "handler-count.json"],
      "outputs": ["finish.json"],
      "check": "npm run check:catalog"
    }
  ]
}
