{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caelos engine script chain",
  "type": "object",
  "required": ["chain", "steps"],
  "additionalProperties": false,
  "x-caelos-unique-step-names": true,
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "kind", "script", "inputs", "outputs", "check"],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "const": "script"
          },
          "script": {
            "type": "string",
            "minLength": 5,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.mjs$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "check": {
            "const": "npm run check:catalog"
          }
        }
      }
    }
  }
}
