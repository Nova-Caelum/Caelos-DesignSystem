{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caelos engine chain",
  "type": "object",
  "required": ["chain", "steps"],
  "additionalProperties": false,
  "x-caelos-unique-step-names": true,
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "kind", "inputs", "outputs", "check"],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": { "kind": { "const": "script" } },
            "required": ["script"]
          },
          {
            "properties": { "kind": { "const": "model" } },
            "required": ["instructions", "schema"]
          }
        ],
        "properties": {
          "step": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": ["script", "model"]
          },
          "script": {
            "type": "string",
            "minLength": 5,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.mjs$"
          },
          "instructions": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
          },
          "schema": {
            "type": "string",
            "minLength": 6,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "check": {
            "const": "npm run check:catalog"
          }
        }
      }
    }
  }
}
