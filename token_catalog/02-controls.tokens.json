      "chip": {
        "$description": "Present compact labels and selectable chip states.",
        "$extensions": {
          "app.caelos": {
            "status": "open",
            "inventoryName": "chip",
            "recipeInStaging": true,
            "variants": {
              "variant": [
                "filter",
                "status",
                "count",
                "category"
              ],
              "tone": [
                "neutral",
                "ready",
                "progress",
                "done",
                "sage",
                "danger",
                "atmospheric",
                "structural"
              ]
            },
            "defaultVariants": {
              "variant": "filter",
              "tone": "neutral"
            },
            "states": [
              "hover",
              "active",
              "disabled"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D81",
              "D24"
            ],
            "note": "The Figma draft's 9 chip tokens are not admitted: padding on the rejected second scale, 20px radius (D21)."
          }
        }
      },
      "avatar": {
        "$description": "Present identity images, fallbacks and status indicators.",
        "$extensions": {
          "app.caelos": {
