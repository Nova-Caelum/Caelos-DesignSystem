      "button": {
        "$description": "Express shared action emphasis, size and button states.",
        "$extensions": {
          "app.caelos": {
            "status": "partial",
            "inventoryName": "button",
            "recipeInStaging": true,
            "variants": {
              "variant": [
                "primary",
                "tonal",
                "text"
              ],
              "size": [
                "sm",
                "md"
              ],
              "danger": [
                true
              ]
            },
            "defaultVariants": {
              "variant": "tonal",
              "size": "md"
            },
            "states": [
              "default",
              "hover",
              "pressed",
              "success",
              "focus",
              "disabled"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D50",
              "D82",
              "D25"
            ],
            "note": "The approved medium radius applies across variants, sizes and states. Paint roles below describe the existing Figma masters in both motion modes. Draft padding used the rejected second scale (D01).",
            "statePaints": {
              "primary": {
                "default": {
                  "fill": "{primitives.shared.surface.button.bed}",
                  "tintInk": "{primitives.shared.surface.button.default}",
                  "tintOpacity": "{primitives.shared.surface.button.tint}",
                  "foreground": "{primitives.shared.typography.tone.default}"
                },
                "hover": {
                  "fill": "{primitives.shared.surface.button.bed}",
                  "tintInk": "{primitives.shared.surface.button.hover}",
                  "tintOpacity": "{primitives.shared.surface.button.tint}",
                  "foreground": "{primitives.shared.typography.tone.default}"
                },
                "pressed": {
                  "fill": "{primitives.shared.surface.button.bed}",
                  "tintInk": "{primitives.shared.surface.button.pressed}",
                  "tintOpacity": "{primitives.shared.surface.button.tint}",
                  "foreground": "{primitives.shared.typography.tone.default}"
                },
                "success": {
                  "fill": "{primitives.shared.surface.button.bed}",
                  "tintInk": "{primitives.shared.surface.button.success}",
                  "tintOpacity": "{primitives.shared.surface.button.tint}",
                  "foreground": "{primitives.shared.typography.tone.default}"
                },
                "focus": {
                  "fill": "{primitives.shared.surface.button.bed}",
                  "foreground": "{primitives.shared.recipes-focus.foreground}",
                  "glowInk": "{primitives.shared.recipes-focus.glow-ink}",
                  "glowBlur": "{primitives.shared.recipes-focus.glow-blur}",
                  "glowOpacity": "{primitives.shared.recipes-focus.glow-opacity}",
                  "glowOffset": "{primitives.shared.surface.button.glow-offset}"
                },
                "disabled": {
                  "fill": "{primitives.shared.surface.button.disabled-bed}",
                  "foreground": "{primitives.shared.typography.tone.dim}"
                }
              },
              "tonal": {
                "default": {
                  "fill": "{sys.color.elevated-2}",
                  "foreground": "{sys.color.text-primary}"
                },
                "success": {
                  "fill": "{sys.color.structural-violet}",
                  "foreground": "{sys.color.text-primary}"
                },
                "disabled": {
                  "fill": "{sys.color.elevated-2}",
                  "foreground": "{sys.color.text-tertiary}"
                }
              },
              "text": {
                "default": {
                  "foreground": "{sys.color.text-primary}"
                },
                "success": {
                  "foreground": "{sys.color.text-primary}"
                },
                "disabled": {
                  "foreground": "{sys.color.text-tertiary}"
                }
              }
            },
            "constructionPolicy": "State construction references lower-tier tokens directly. Button token leaves remain compatibility exports; they are not additional ingredients."
          }
        },
