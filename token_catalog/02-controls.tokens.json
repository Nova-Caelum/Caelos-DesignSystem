{
  "controls": {
    "$description": "Controls: one interactive element. References only lower tiers.",
    "$extensions": {
      "app.caelos": {
        "tier": 2,
        "open": [
          {
            "item": "button and chip values",
            "ref": "D50, D81, G04, G05",
            "why": "Button and chip padding, height, timing and focus remain open, as does chip radius. The shared button radius is decided."
          }
        ]
      }
    },
    "shared": {
      "badgeVariants": {
        "$description": "Set badge emphasis and status treatments.",
        "$extensions": {
          "app.caelos": {
            "status": "open",
            "inventoryName": "badgeVariants",
            "recipeInStaging": true,
            "variants": {
              "variant": [
                "default",
                "secondary",
                "destructive",
                "outline",
                "ghost",
                "link"
              ]
            },
            "defaultVariants": {
              "variant": "default"
            },
            "states": [
              "hover",
              "focus-visible",
              "focus",
              "error"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ]
          }
        }
      },
      "buttonVariants": {
        "$description": "Set host button size and action emphasis.",
        "$extensions": {
          "app.caelos": {
            "status": "open",
            "inventoryName": "buttonVariants",
            "recipeInStaging": true,
            "variants": {
              "variant": [
                "default",
                "outline",
                "secondary",
                "ghost",
                "destructive",
                "link"
              ],
              "size": [
                "default",
                "xs",
                "sm",
                "lg",
                "icon",
                "icon-xs",
                "icon-sm",
                "icon-lg"
              ]
            },
            "defaultVariants": {
              "variant": "default",
              "size": "default"
            },
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D50"
            ]
          }
        }
      },
      "controlSkin": {
        "$description": "Express destructive and non-destructive control emphasis.",
        "$extensions": {
          "app.caelos": {
            "status": "open",
            "inventoryName": "controlSkin",
            "recipeInStaging": true,
            "variants": {
              "kind": [
                "danger",
                "glass"
              ]
            },
            "defaultVariants": {
              "kind": "danger"
            },
            "states": [
              "hover",
              "disabled"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ]
          }
        }
      },
      "button": {
        "$description": "Express shared action emphasis, size and button states.",
        "$extensions": {
          "app.caelos": {
            "status": "partial",
            "inventoryName": "button",
            "recipeInStaging": true,
            "variants": {
              "variant": [
                "primary",
                "tonal",
                "text"
              ],
              "size": [
                "sm",
                "md"
              ],
              "danger": [
                true
              ]
            },
            "defaultVariants": {
              "variant": "tonal",
              "size": "md"
            },
            "states": [
              "hover",
              "disabled"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D50",
              "D82",
              "D25"
            ],
            "note": "The approved button radius applies across variants, sizes and states. Draft padding used the rejected second scale (D01)."
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{base.radius.md}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "figmaName": "button/radius",
              "note": "Medium corners approved in the Tier 2 Controls review against fused staging."
            }
          }
        }
      },
      "input": {
        "$description": "Present input containers, labels and editable field states.",
        "$extensions": {
          "app.caelos": {
            "status": "partial",
            "inventoryName": "input",
            "recipeInStaging": true,
            "slots": [
              "root",
              "control",
              "icon",
              "clear",
              "label",
              "description"
            ],
            "variants": {
              "variant": [
                "text",
                "search",
                "large"
              ]
            },
            "defaultVariants": {
              "variant": "text"
            },
            "states": [
              "hover",
              "focus",
              "active",
              "disabled",
              "error"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D12",
              "D52",
              "D25"
            ],
            "darkReview": {
              "states": [
                "rest",
                "hover",
                "focus",
                "disabled",
                "needs-attention"
              ],
              "requiredError": "empty required text field",
              "multilineResize": "vertical",
              "note": "Current role selections for geometry, surfaces and typography are pending visual review."
            }
          }
        },
        "label-gap": {
          "$type": "dimension",
          "$value": "{sys.space.field-interior}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D12",
              "note": "Label to control."
            }
          }
        },
        "description-gap": {
          "$type": "dimension",
          "$value": "{sys.space.field-interior}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D12",
              "note": "Control to help text."
            }
          }
        },
