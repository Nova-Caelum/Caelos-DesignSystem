{
  "controls": {
    "$description": "Controls: one interactive element. References only lower tiers.",
    "$extensions": {
      "app.caelos": {
        "tier": 2,
        "open": [
          {
            "item": "button and chip values",
            "ref": "D50, D81, G04, G05",
            "why": "Button and chip padding, height and timing remain open, as do chip radius and focus. Tonal and text button hover, pressed and focus treatments await review."
          }
        ]
      }
    },
