            "states": [
              "focus-visible",
              "focus"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ]
          }
        },
        "initials-size": {
          "$description": "Initials font size by avatar frame size. XL uses the reviewed 18px step. XXL uses the 20px step derived from the original proportional sizing, pending visual review.",
