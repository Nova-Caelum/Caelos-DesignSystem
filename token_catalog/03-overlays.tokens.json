{
  "overlays": {
    "$description": "Overlays and feedback: floats above or announces. References only lower tiers.",
    "$extensions": {
      "app.caelos": {
        "tier": 3,
        "open": [
          {
            "item": "panel slide",
            "ref": "D38",
            "why": "One shared role for drawer and sidebar; duration and curve undecided."
          }
        ]
      }
    },
    "shared": {
      "alert": {
        "$description": "Present alert content, emphasis and its dismiss or follow-up actions.",
        "$extensions": {
          "app.caelos": {
            "status": "partial",
            "inventoryName": "alert",
            "recipeInStaging": true,
            "slots": [
              "stage",
              "root",
              "head",
              "icon",
              "title",
              "kicker",
              "pager",
              "body",
              "lede",
              "command",
              "actions",
              "choices"
            ],
            "variants": {
              "tone": [
                "progress",
                "accent",
                "ready",
                "danger",
                "sage",
                "none"
              ],
              "material": [
                "tonal",
                "glass"
              ],
              "edge": [
                "system",
                "tone"
              ],
              "glow": [
                true,
                false
              ]
            },
            "defaultVariants": {
              "tone": "none",
              "material": "tonal",
              "edge": "system",
              "glow": true
            },
            "states": [
              "active",
              "open"
            ],
            "modes": [
              "dark",
              "light",
              "reduced-motion",
              "reduced-transparency"
            ],
            "decisions": [
              "D62",
              "D26"
            ],
            "note": "Padding is decided as 15 / 18 / 18px, but which side takes which value was not recorded (D62)."
          }
        },
        "stack-gap": {
          "$type": "dimension",
          "$value": "{base.measure.alert-stack-gap}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D62"
            }
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{base.radius.xl}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D62"
            }
          }
        },
        "icon-size": {
          "$type": "dimension",
          "$value": "{base.measure.alert-icon}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D62"
            }
          }
        },
        "icon-gap": {
          "$type": "dimension",
          "$value": "{base.space.step-03}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D62"
            }
          }
        },
        "edge-width": {
          "$type": "dimension",
          "$value": "{base.border.hairline}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D26"
            }
