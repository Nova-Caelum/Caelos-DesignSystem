{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caelos catalog entry record",
  "type": "object",
  "required": ["lifecycle"],
  "properties": {
    "lifecycle": { "type": "string", "enum": ["draft", "promoted", "placeholder"], "x-caelos-ignore-for-change": true },
    "draftedBy": { "type": "string", "minLength": 1, "x-caelos-ignore-for-change": true },
    "draftedAt": { "type": "string", "format": "date-time", "x-caelos-ignore-for-change": true },
    "kind": {
      "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "x-caelos-required-on-active-recipe": true
    },
    "madeOf": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "x-caelos-required-from-tier": 3
    },
    "contents": {
      "type": "object", "minProperties": 1,
      "x-caelos-recipe-tier": 3
    },
    "layerOrder": {
      "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
    },
    "gapFill": { "type": "string", "enum": ["reference", "nearest", "placeholder"] },
    "siblings": {
      "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
    }
  }
}
