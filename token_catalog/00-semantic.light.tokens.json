        "saturation": {
          "$type": "number",
          "$value": "{base.material.saturation.menu}",
          "$extensions": {
            "app.caelos": {
              "status": "canon",
              "decision": "D29"
            }
          }
        }
      },
      "glass-blur": {
        "$type": "dimension",
        "$value": "{base.material.light.blur}",
        "$extensions": {
          "app.caelos": {
            "status": "provisional",
            "decision": "D31",
            "note": "D31 decides one role for content behind glass; its value is assumed equal to the panel blur (D29)."
          }
        }
      }
    }
