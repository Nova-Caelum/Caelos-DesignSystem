            "states": [
              "rest",
              "editor-focus-visible",
              "control-focus-visible"
            ],
            "modes": [
              "dark",
              "reduced-transparency",
              "forced-colors"
            ],
            "reviewNotes": [
              "The prototype defaults to a glass strip over paper. The action bar demonstrates a cloud strip over glass. Review each pairing independently.",
              "Crossfade only the adjacent background planes. Text and controls stay opaque. A single outer edge follows the card shape through the join.",
              "Editor focus belongs to the shell. A button inside the card keeps its own focus treatment.",
              "Review the opaque fallback with reduced transparency or unavailable backdrop blur and check system colors in forced-colors mode."
            ]
          }
        }
      },
      "actionBar": {
        "$description": "Choose a command, edit its arguments inline, review the selection and execute it.",
