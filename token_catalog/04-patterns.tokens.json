      "fusionCard": {
        "$description": "Join a strip and body on one continuous card surface.",
        "$extensions": {
          "app.caelos": {
            "status": "open",
            "inventoryName": "fusionCard",
            "recipeInStaging": false,
            "slots": [
              "root",
              "strip",
              "body",
              "editor"
            ],
            "variants": {
              "stripMaterial": [
