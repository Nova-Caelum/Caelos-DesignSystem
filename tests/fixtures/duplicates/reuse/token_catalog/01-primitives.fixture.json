{
  "primitives": {
    "shared": {
      "surface": {
        "fill": {
          "$type": "color",
          "$value": "{base.color.ink}"
        },
        "reused-fill": {
          "$type": "color",
          "$value": "{base.color.ink}"
        }
      },
      "empty-record": {
        "$extensions": {
          "app.caelos": {
            "states": ["idle"],
            "variants": {
              "tone": ["quiet", "loud"]
            }
          }
        }
      }
    }
  }
}
