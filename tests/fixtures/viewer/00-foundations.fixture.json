{
  "base": {
    "color": {
      "ink": {
        "$type": "color",
        "$value": "#080817",
        "$extensions": {
          "app.caelos": {
            "lifecycle": "promoted",
            "status": "draft"
          }
        }
      }
    },
    "space": {
      "repeat": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      }
    },
    "blur": {
      "repeat": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    },
    "grouped": {
      "scale": {
        "compact": {
          "$type": "dimension",
          "$value": {
            "value": 3,
            "unit": "px"
          }
        }
      }
    }
  }
}
