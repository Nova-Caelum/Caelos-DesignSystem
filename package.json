{
  "name": "caelos-design-system-catalog",
  "private": true,
  "exports": {
    ".": "./generated/components/index.ts",
    "./components": "./generated/components/index.ts",
    "./tailwind-theme.css": "./generated/tailwind-theme.css",
    "./tokens.css": "./generated/tokens.css"
  },
  "files": [
    "generated/"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "node --test",
    "test:browser": "node --test tests/browser-checks/behaviour-browser.check.mjs",
    "build:tokens": "node style-dictionary.config.mjs",
    "build:components": "node scripts/generate-components.mjs",
    "build:lock": "node scripts/build-lock.mjs",
    "build": "npm run build:tokens && npm run build:components && npm run build:lock",
    "check:app": "node scripts/check-app.mjs",
    "check:behaviour": "node scripts/behaviour-check/run-behaviours.mjs",
    "check:catalog": "node scripts/check-recipes.mjs --catalog scripts/check-tier-drift.cjs check:recipes check:ratchet check:generated check:duplicates check:engine --",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:recipes": "node scripts/check-recipes.mjs",
    "check:ratchet": "node scripts/check-ratchet.mjs"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "playwright": "1.65.1",
    "style-dictionary": "5.8.0",
    "typescript": "5.8.2"
  }
}
