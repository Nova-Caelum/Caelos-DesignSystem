set -eu
git_root=$(pwd)
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
# Test fixtures create their own repositories. Do not pass this checkout's
# Git directory or index into those repositories.
export NODE_PATH="$(pwd)/node_modules"
repo_env=$(git rev-parse --local-env-vars)
if git rev-parse --verify -q HEAD >/dev/null; then
  catalog_base=HEAD
else
  catalog_base=none
fi
(
  unset $repo_env
  cd "$snapshot"
  CAELOS_CATALOG_GIT_ROOT="$git_root" npm run check:catalog -- --base "$catalog_base"
  node --test
)
